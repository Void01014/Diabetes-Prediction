FROM apache/airflow:2.10.2-python3.11

USER airflow

# Install training dependencies on top of the Airflow image.
# scikit-learn must match the version used in the trainer/api images
# so that any model retrained by the DAG is loadable by the API
# (after an api container restart).
RUN pip install --no-cache-dir \
    scikit-learn==1.9.1 \
    imbalanced-learn==0.14.2 \
    mlflow==3.17.0 \
    pandas==3.0.6 \
    numpy==2.4.6 \
    matplotlib==3.11.2 \
    scipy==1.17.1 \
    joblib==1.6.0
